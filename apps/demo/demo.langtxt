# DEMONS ÖVERSÄTTNINGAR — id 1000+. Demon har ALL text som kan ändras:
# appen ska demonstrera vad som är möjligt, och ett halvöversatt demo visar
# motsatsen till vad ramverket kan.
#
# KÄLLAN till apps/demo/language.bin OCH till den committade
# demo_strings.h. Packa om efter varje ändring:
#
#   ./build/apps/glazelanguage/glazelanguage pack \
#       --header apps/demo/src/demo_strings.h --ns demo::str --reflang sv \
#       apps/demo/demo.langtxt apps/demo/language.bin
#
# ID-BLOCKEN är avsiktligt glesa, så en ny sträng i ett fönster inte
# tvingar fram omnumrering någon annanstans:
#   1000–1099  start_window          1100–1119  second_window
#   1120–1129  about_dialog          1130–1139  free_window
#   1200–1299  widget_gallery
#   1340–1379  widget_gallery: träd · tooltip · flikarna (1360–1374)
#   1380–1399  widget_gallery: listvy · datagrid
#   1420–1439  widget_gallery: delare · dockning
#   1440–1449  widget_gallery: filväljarfältet
#   1450–1459  widget_gallery: färgväljaren (fliken "Väljare" är 1375)
#   1460–1469  widget_gallery: datumväljaren
#   1470–1479  widget_gallery: det flerradiga fältet
#   1480–1509  widget_gallery: ritytan (fliken "Rityta" är 1376; "Spara"
#              1350 och "Återställ" 1434 återanvänds; 1505–1507 vridsnäppets
#              vallista — gradtalen är tal och står inte här)
#   1510–1519  widget_gallery: kolumnrubrikerna (rubrikerna BÄR
#              radbrytningar, `\n` i literalen, och standardens nationella
#              prefix följer språket: SS · NEK · SFS, engelskan bara EN)
#   1520–1569  widget_gallery: ritytan i 3D — 1520–1535
#              fliken "3D" (fliken är 1377; "Etiketter" 1486 återanvänds),
#              1536–1537 och 1550–1569 porteringsprovningen: fliken
#              "3D-verktyg" (fliken är 1378; "Rutnät" 1521 återanvänds) och
#              3D-flikens förstaperson och punktplockning
#   1570–1589  tray_window — systemfältsappen, `demo --tray`;
#              "Avsluta" 1004 och "Om GlazeUI…" 1012 återanvänds
#   1590–1599  widget_gallery: textfälten — grupp 29, lösenordet,
#              ångra och radbrytningen som följer layoutens bredd
#              (1590–1594); "Ctrl+Z"/"Ctrl+Y" i fotraden är tangentnamn och
#              står likadant i alla fyra språken
#   1600–1609  widget_gallery: träd och listor — trädets
#              kryss och flerval i statusraden (1600–1602); grupp 13:s fot
#              (1345) och grupp 5:s (1230) har fått nya texter på plats
#   1700–1739  dock_window — dockningen, `demo --dock`;
#              panelernas titlar (1702–1705, 1725) är också Visa-menyns
#              poster, 1717–1724 verktygsfälten, 1725–1726 den
#              flytande panelen, 1727–1730 verktygsfältens titlar — det
#              flytande fältets rubrik
#   1740–1749  widget_gallery: rullgardinsknapparna — grupp 9:s
#              tredje remsa, "Ny ▾" och den delade "Ångra ▾" med historiken;
#              dock_window:s rullgardiner återanvänder dem
#   1750–1759  splash_window — splashen, `demo --splash`
#   1760–1789  window_lab — fönsterlabbet, `demo --window-lab`
#              talen, "x"/"y" och tecknen i geometriraden
#              står likadant i alla fyra språken
#   1800–1819  widget_gallery: inmatningen — grupp 30 på
#              fliken Interaktion (1800–1811): Ctrl+Enter i ett fält,
#              högerknappens linjal, dubbelklicken, avbrottet och mellanslaget;
#              "px" i längden är en enhet och står inte här
#   1820–1829  widget_gallery: ritytans lagerlista — ▲/▼:s
#              tooltips efter Microsofts Flytta framåt/bakåt, listans prefix
#              och statusradens ordning; pilarna är tecken och står inte här
#   1830–1839  widget_gallery: dialoger och fält — fältens
#              platshållare (1830 lösenordet i grupp 29, 1831 anteckningen i
#              grupp 24); "16" i lösenordets hint är ett tal
#   1840–1849  widget_gallery: träd och listor — trädets
#              godkännande i statusraden (1840–1841) och listvyns kryss i en
#              tooltip (1842); trädets tooltip 1358 har fått ny text på plats
#   1865–1884  widget_gallery: kryssrutans tre
#              lägen (grupp 31), listboxens flerval (32), datagridens radval
#              (33), datumväljarens klockslag (rad i grupp 23) och dialogerna
#              (34); lagrens namn 1483–1486 och ramverkets "Alfa" återanvänds
#   1900–1919  widget_gallery: träd, listor och fält —
#              trädets snabbmeny och statusraden mot noden och raden
#              (1900–1901), grupp 36 på fliken Text (1902–1905; "Namn" 1381
#              återanvänds) och filväljarens dialogtitel (1906); anteckningen
#              1471 har fått Tab-meningen på plats, och spårens namn
#              ("01.flac" …) är data och står inte här
#   1920–1934  widget_gallery grupp 35, window_lab, dock_window —
#              storleken och tangentens text i grupp
#              35 på fliken Interaktion (1920–1925), fönsterlabbets
#              innehållsyta, aktiva fönster och dialogen som följer sitt
#              innehåll (1926–1931), dockningens "Mät" med genvägen M och
#              Redigera-fältets kanter (1932–1934); "Stäng" 1040 återanvänds,
#              och "«»", "×" och tangentnamnen är tecken och står inte här
#   1935–1949  widget_gallery: ritytans text med tak — kartans
#              anteckning (1935); "Kyrkbacken" och husens namn är kartans
#              egennamn och står inte här
#   1950–1969  form_dialog och window_lab — fönsterlabbets
#              knapp "Formulär…" (1950) och formuläret (1951–1960); "Namn"
#              1381 återanvänds, OK och Avbryt är ramverkets, och kontakternas
#              namn i listan är data och står inte här
#   1970–1989  widget_gallery: Markdown-vyn — grupp 37 på
#              fliken Text: rubriken (1970), statusradens "Länk: " (1971),
#              DOKUMENTET (1972 — rubriker, listor, betoning, kod, citat, linje,
#              länkar, bilder och en tabell, och ankarlänkarna följer språkets
#              rubriker), den korta AUTO-höga vyn (1973) och raden under den
#              (1974); `demo:data` och bildnamnen är data och står likadant
#   2000–2009  dock_window: terminalen — panelens rubrik och
#              Visa-menyns post (2000), statusradens slutkod (2001) och
#              startfelet (2002); Kopiera/Klistra in är Redigera-fältets
#              (1721/1722) och återanvänds i terminalens snabbmeny
#   2010–2019  widget_gallery: inmatningen — grupp 27:s
#              lägesval (2010–2014), vändningarnas kryssrutor (2015–2017)
#              och listans tooltip om dess vända hjul (2018)
#
# ÅTERANVÄNDNING är regeln, inte undantaget: "Stäng" har ETT id och
# används i fyra fönster. Och ramverkets egna roller (OK · Avbryt · Ja ·
# Nej · Försök igen · Ignorera) tas ur `glaze::str::*` — de finns redan
# översatta i alla fyra språken, och ett eget id hade varit en andra
# sanning som kan glida isär.
#
# DET SOM INTE STÅR HÄR, med skäl:
#   * `name`-rader, assetnycklar, dock-värden och genvägar — inte UI-text.
#   * EGENNAMN i listor (Glaze · Slate · Minimalistic) och API-namn
#     (Custom · Information · OKCancel · None · Left …) — de heter samma
#     sak på varje språk, och att översätta ett typnamn hade gjort demon
#     falsk om vad API:t heter.
#   * TAL (0.8 · 0.9 · 1.0 …) i skala-listan.
#   * EXEMPLETS DATA i galleriet: filnamnen och storlekarna i listvyn, trädet
#     och flikarna ("Rapport.pdf", "12 kB"), datagridens rader, protokoll
#     (HTTP · FTP …) och kolumnen "Id", och PropertyGrid-radernas namn och
#     värden ("name", "text", "Tryck här") — de står för det en app hade
#     läst ur en fil eller en modell, inte för UI-text. Likaså KARTANS
#     egennamn på ritytans flik (Storgatan · Lillsjön · Ekparken …) — en
#     svensk karta heter samma sak på varje språk. Kartans KATEGORIER
#     (Badplats · Hållplats …) och lagrens namn är däremot UI-text och står
#     här: de visar att en text i ritytans formlista följer språket.
#   * ENHETER och tecken: "px/mm", "dpi", "mm", "x =", "-" och "+".
#
# TERMERNA: nb, fi och en följer ramverkets termer och Microsofts, GTK:s
# och Qt:s översättningar. Engelskan skrivs med AMERIKANSK stavning (color,
# canceled) — API:t heter `ColorPicker`. Tangentnamnen i löptext följer
# ramverkets egna (Skift, Vaihto). Finskans "inaktiverad" är ETT uttryck,
# "ei käytössä" (Windows på/av-läge): en blandning av former hade gett den
# längsta i galleriets smala rutor.
#
# ATT GRANSKA (modersmålstalare):
#   fi "ei käytössä" överallt — GTK skriver "Pois käytöstä", och
#        "poissa käytöstä" är en annan vanlig form
#   nb 1008/1009 "Lyst"/"Mørkt" — Windows "Velg modus: Lys/Mørk", men samma id
#        står också efter "Tema:" (intetkön)
#   nb 1021 "… står igjen" — kanske "… blir stående"
#   nb 1225 "avkryssingsbokser" — Microsoft säger "avmerkingsboks"
#   fi 1108/1113 "viestiruutu" — Microsofts äldre texter säger "sanomaruutu"
#   fi/nb 1511–1514 linberäkningens fackord: "Jänne"/"Spenn" för
#        spannet, "Riippuma … projektio"/"Nedheng … projeksjon" för nedhänget
#        och standardens nationella prefix SFS/NEK — skrivna utan fackgranskare
#   nb/fi 1505 vridsnäppet: "Fest dreiing" efter Microsofts "Fest
#        til rutenett", "Kierron kohdistus" efter "Kohdista ruudukkoon"
#   nb/fi 1523/1528 3D-flikens fackord: linorna
#        "Liner"/"Johtimet" och nätstationen "Nettstasjon"/"Muuntamo" — skrivna
#        utan fackgranskare
#   nb/fi 1531 terrängens ord: "draperte veier" och
#        "maasto, jonka pintaan tiet on piirretty" för draperingen, och fi
#        "oma varjostin" för det egna programmet — skrivna utan fackgranskare
#   nb/fi 1552–1561 3D-verktygsflikens CAD-ord: fi
#        "Särmät"/"Piiloviivat"/"Särmätila" för kanterna och kantläget,
#        "Näkymäkuutio" och kubens sidor "Ylä/Ala/Etu/Taka/Vasen/Oikea", nb
#        "Navigasjonskube" och "Kantmodus" — skrivna utan fackgranskare
#   fi 1564/1565 "Minäkuvakulma" för förstapersonen (spelens ord) och
#        "vetäminen katselee" för musblicken
#   nb/fi 1570–1584 systemfältets namn: "systemstatusfeltet"
#        och "ilmaisinalue" efter Windows; macOS kallar platsen menyraden —
#        skrivna utan modersmålstalare
#   nb/fi 1590–1594 textfälten: "angre"/"gjør om" och
#        "kumoaa"/"tekee uudelleen" efter Microsofts Ångra/Gör om, "skillet"
#        och "jakaja" som grupp 15 — skrivna utan modersmålstalare
#   nb/fi 1345 och 1600–1601 trädets kryss: "krysser av"/
#        "Krysset av"/"Kryss fjernet" och "rastittaa"/"Rastitettu"/"Rasti
#        poistettu" — Microsoft säger "merket av" respektive "valittu", men
#        "valittu" är redan VALET i samma rad — skrivna utan modersmålstalare
#   nb/fi 1700–1726 dockningen: "Utforsker"/"Resurssienhallinta"
#        efter Windows Utforskaren, "Oppsett"/"Asettelu" för layouten,
#        "stabel"/"pino" för en staplad panel, "kahva" för handtaget och
#        verktygsfältets grepp, "verktøylinje"/"työkalurivi" och
#        "bånd"/"kaista" för banden, "Overvåking"/"Valvonta" efter
#        Visual Studios Bevakning och "Forankre"/"Telakoi" för Docka —
#        skrivna utan modersmålstalare
#   nb/fi 1712/1726 och 1727–1730 det levande draget och fältens titlar
#        "plassholderen"/"paikkamerkin" efter Microsofts
#        platshållare, "Feilsøk"/"Virheenjäljitys" efter Visual Studios Felsök
#        — skrivna utan modersmålstalare
#   nb/fi 1740–1749 rullgardinsknapparna: "Angre"/"Kumoa" och
#        "Mappe"/"Kansio" efter Microsofts Ångra och Mapp, "Angret"/"Kumottu"
#        för det ångrade och "delt"/"jaettu" för den delade knappen — skrivna
#        utan modersmålstalare
#   nb/fi 1750–1778 splashen och fönsterlabbet: "tidtaker"
#        och "ajastin" för timern, fönsterlägena "Minimert/Maksimert" och
#        "Pienennetty/Suurennettu" efter Windows Minimera/Maximera, och
#        pekarnas namn — skrivna utan modersmålstalare
#   nb/fi 1800–1811 inmatningen: "Inndata"/"Syöte" för
#        rubriken, "midtknappen"/"keskipainike" och "mellomrom"/"välilyönti"
#        efter Windows tangent- och musnamn, "avbrutt"/"keskeytetty" för det
#        avbrutna — skrivna utan modersmålstalare
#   nb/fi 1820–1823 ritytans lagerlista: "Flytt fremover/
#        bakover" och "Tuo eteenpäin/Vie taaksepäin" efter Microsofts Flytta
#        framåt/bakåt, "Lag"/"Taso" för lagret — skrivna utan modersmålstalare
#   nb/fi 1830–1831 fältens platshållare: "maks." och
#        "enintään" för gränsen, "notat"/"muistiinpano" för anteckningen —
#        skrivna utan modersmålstalare
#   nb/fi 1358 och 1840–1842 trädets godkännande och listvyns kryss
#        "krysser av"/"rastittaa" som 1345, "sortert inn
#        alfabetisk"/"lajiteltu aakkosjärjestykseen" och "øverst"/"ylimmälle
#        tasolle" för toppnivån — skrivna utan modersmålstalare
#   nb/fi 1471 och 1900–1906 träd, listor och fält:
#        "Hurtigmeny"/"Pikavalikko" efter Microsofts snabbmeny, "tabulator"/
#        "sarkain" för tabben, "Nimiöt" för etiketterna och "kolmella
#        pisteellä" för ellipsen — skrivna utan modersmålstalare
#   nb/fi 1920–1934 storleken, tangenterna och fönstret:
#        "Flaten"/"Pinta" för ritytan, "Følg innholdet"/"Sovita sisältöön"
#        för att följa innehållet, "Mål"/"Mittaa" och "Dokkes"/"Telakoituu"
#        för dockningen — skrivna utan modersmålstalare
#   nb/fi 1935 kartans anteckning: "Gravetillatelse"/"Kaivulupa"
#        för grävtillståndet och "ledes om"/"ohjataan … kautta" för
#        omledningen; gatunamnen står kvar som egennamn — skrivna utan
#        modersmålstalare
#   nb/fi 1950–1960 formuläret: "Skjema"/"Lomake" för
#        formuläret, "Yhteystiedot" för kontaktramen och "Yhteyshenkilöt" för
#        listan; fi "Postinumero ja -toimipaikka" är vald för att vara LÅNG
#        (etikettkolumnen ska breddas), inte för att den är idiomatisk —
#        skrivna utan modersmålstalare
#   nb/fi 1970–1974 Markdown-vyn: "visningen"/"näkymä" för
#        vyn, "rullende flate"/"vierivä alue" för den rullande ytan och
#        "lat linje"/"laiska rivi" för CommonMarks lata fortsättningsrad —
#        skrivna utan modersmålstalare
#   nb/fi 2000–2002 terminalen: "Terminal"/"Pääte" för
#        terminalen — skrivna utan modersmålstalare
#   nb/fi 2010–2018 inmatningen: "Modus"/"Tila" för läget,
#        "snu"/"käännä" för att vända och "styreplate"/"kosketuslevy" för
#        styrplattan — skrivna utan modersmålstalare

default sv

